# Electricity Maps API Configuration
# Get your API key from: https://portal.electricitymaps.com/
ELECTRICITYMAPS_TOKEN=your_api_key_here

# API Base URL (free tier vs. paid)
# Free tier (non-commercial use):
ELECTRICITYMAPS_BASE=https://api-access.electricitymaps.com/free-tier
# Paid tier:
# ELECTRICITYMAPS_BASE=https://api.electricitymaps.com

# Default values for calculations
DEFAULT_GRID_KG_PER_KWH=0.4
DEFAULT_PUE=1.2
